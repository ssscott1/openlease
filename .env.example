# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only (never expose to the client). Used by API routes for
# privileged inserts (lead capture) and by the email edge function.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend) — used by the Supabase Edge Function
RESEND_API_KEY=
LEAD_ALERT_EMAIL=sales@openlease.example
